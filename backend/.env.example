# FAUNA BATTLER AI - Backend environment template
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# --- Supabase -----------------------------------------------------------
# Found under: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# IMPORTANT: use the SERVICE ROLE key here (server-side only). Do NOT put this
# key in the Flutter app - the app uses the public anon/publishable key instead.
SUPABASE_KEY=your-service-role-key

# --- OpenRouter (OpenAI-compatible vision provider) ---------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# Vision-capable model slug in `vendor/model` form. Model names change often -
# check https://openrouter.ai/models for the current list before running.
# (A bare name like `gpt-4o` is auto-prefixed to `openai/gpt-4o`.)
OPENROUTER_VISION_MODEL=openai/gpt-4o
# Optional: override the OpenAI-compatible endpoint (defaults to OpenRouter).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- App / CORS ---------------------------------------------------------
# "development" enables verbose errors; "production" hides internal details.
APP_ENV=development
# Comma separated list, or "*" to allow all origins (fine for mobile clients).
ALLOWED_ORIGINS=*
